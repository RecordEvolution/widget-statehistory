{
    "name": "@ironflock/widget-statehistory",
    "description": "Webcomponent widget-statehistory following open-wc recommendations",
    "license": "MIT",
    "author": "widget-statehistory",
    "version": "1.0.24",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-statehistory.js",
    "types": "dist/src/widget-statehistory.d.ts",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "start": "vite build --watch & vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "link": "npm run build && npm link && cd ../RESWARM/frontend && npm link @ironflock/widget-statehistory",
        "unlink": "npm unlink --global && cd ../RESWARM/frontend && npm unlink @ironflock/widget-statehistory && npm i @ironflock/widget-statehistory",
        "types": "cat src/definition-schema.json | json2ts --style.tabWidth=4 > src/definition-schema.d.ts",
        "preversion": "sh scripts/release-preflight.sh",
        "version": "npm run build",
        "postversion": "git push --follow-tags && sh scripts/release-verify.sh",
        "release": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major"
    },
    "dependencies": {
        "lit": "^3.3.2",
        "luxon": "^3.7.2",
        "tinycolor2": "^1.6.0",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "echarts": "^6.0.0"
    },
    "devDependencies": {
        "@rollup/plugin-replace": "^6.0.2",
        "@types/luxon": "^3.7.1",
        "@types/tinycolor2": "^1.4.6",
        "json-schema-to-typescript": "^15.0.4",
        "typescript": "5.9.3",
        "vite": "^7.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-statehistory.git"
    },
    "keywords": [
        "widget",
        "statehistory"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-statehistory/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-statehistory#readme"
}
